// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.

#include "vertexVersionSimple.h"
#include "uniformWorldConstants.h"
#include "uniformPerFrameConstants.h"
#include "uniformShaderConstants.h"

uniform vec4 SUN_DIR;
attribute mediump vec4 POSITION;
attribute vec4 COLOR;

varying vec4 color;
varying vec4 position;
varying vec3 sunat;

const float fogNear = 0.8; // DEFAULT:0.9
const vec3 inverseLightDirection = vec3(0.62, 0.78, 0.0);
const float ambient = 0.7;

void main(){
    POS4 pos = WORLDVIEWPROJ * POSITION;
	POS4 worldPos = WORLD * POSITION;
 	gl_Position = pos;
	position=POSITION;

	sunat=vec3(SUN_DIR.x*0.8660254038, SUN_DIR.y*0.8660254038, 0.5);
	vec3 normal =(
			COLOR.g<0.8 || POSITION.y==1.0
		?(
			vec3(0.0, 1.0, 0.0)
		):(
			COLOR.g<0.96 ?
			vec3(1.0, 0.0, 0.0) :
			vec3(0.0, 0.0, 1.0)
		)
	);

//	Pure Sun And Moon Lyts
	float DawnDusk=clamp(4.0*(SUN_DIR.y -0.1), 0.0, 1.0);
	color.a=abs(dot(normal, sunat));
	color.a*=DawnDusk;
	color.a=0.85 +0.1732 *color.a;
	color.rgb=vec3(color.a);
	color.a=1.0 -POSITION.y *POSITION.y *clamp(0.04*worldPos.y, 0.0, 1.0);
	color.a*=CURRENT_COLOR.a;

//	Fog Included
	vec2 skyUV=worldPos.xz /RENDER_DISTANCE;
	float depth =length(skyUV);
 	float fog =max(depth -fogNear, 0.0);
 	color.a *=1.0 -fog;

//	Day-Nyt Ambiences
	float lyt=(
		0.299*CURRENT_COLOR.r+
		0.587*CURRENT_COLOR.g+
		0.114*CURRENT_COLOR.b
	);
	lyt=0.4 +0.6*lyt;
	vec4 ambience=vec4(1.0);
	if(SUN_DIR.w<0.5){
		ambience.rgb +=
			vec3(-0.7, -0.1, 0.2) *DawnDusk;
	}else if(DawnDusk<1.0 && SUN_DIR.w>0.5){
		skyUV=skyUV -(
			SUN_DIR.x>0.0 ?
			vec2(0.9, 0.0):
			vec2(-0.9,0.0)
		);
		ambience.rgb +=
			vec3(0.4, -0.1, -0.4)*
			4.0 *DawnDusk *(1.0-DawnDusk)*
			(1.0 /(1.0+ 2.0*
				skyUV.x *skyUV.x+
				skyUV.y *skyUV.y
			));
	}
	color*=(lyt *ambience);
}