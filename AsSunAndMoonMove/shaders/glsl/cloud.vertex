// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.

#include "vertexVersionSimple.h"
#include "uniformWorldConstants.h"
#include "uniformPerFrameConstants.h"
#include "uniformShaderConstants.h"
#include "FeatherTools.h" // extra lib

uniform vec4 SUN_DIR;
attribute mediump vec4 POSITION;
attribute vec4 COLOR;
varying vec4 color;

const float fogNear = 0.8; // DEFAULT:0.9
const vec3 inverseLightDirection = vec3(0.62, 0.78, 0.0);
const float ambient = 0.7;

void main(){
	vec4 position=POSITION;
	position.y*=1.8; // thicker
    POS4 pos = WORLDVIEWPROJ *position;
	POS4 worldPos = WORLD *position;
 	gl_Position = pos;

	vec3 sunat=vec3(SUN_DIR.x*0.8660254038, SUN_DIR.y*0.8660254038, 0.5);
	vec3 normal =( // measurement
			COLOR.g<0.8 || POSITION.y==1.0
		?(
			vec3(0.0, 1.0, 0.0)
		):(
			COLOR.g<0.96 ?
			vec3(1.0, 0.0, 0.0) :
			vec3(0.0, 0.0, 1.0)
		)
	);float DawnDusk_4, DawnDusk_8, DawnDusk_16;
	calcDawnDusk4_8_16

//	Pure Sun And Moon Lyts
	color.a =abs(dot(normal, sunat));
	color.a *=DawnDusk_4;
	color.a =0.85 +0.1732 *color.a;
	color.rgb =vec3(color.a);
	color.a =1.0 -POSITION.y *clamp(0.04*worldPos.y, 0.0, 1.0);
	color.a *=CURRENT_COLOR.a;

//	Fog Included
	vec2 skyUV=worldPos.xz /RENDER_DISTANCE;
	float depth =length(skyUV);
 	float fog =max(depth -fogNear, 0.0);
 	color.a *=1.0 -fog;

//	Day-Nyt Ambiences
	float lyt=getGray(CURRENT_COLOR);
	lyt=0.4 +0.6*lyt; // experiencial
	vec4 ambience=vec4(1.0);
	if(SUN_DIR.w<0.5){
		ambience.rgb +=
			vec3(-0.7, -0.1, 0.2) *DawnDusk_8;
	}else if(DawnDusk_4<1.0 && SUN_DIR.w>0.5){
		skyUV=skyUV -(
			SUN_DIR.x>0.0 ?
			0.9*vec2( 0.9539392014,0.3):
			0.9*vec2(-0.9539392014,0.3)
		);
		ambience.rgb +=
			vec3(0.4, -0.15, -0.35)*
			1.5 *DawnDusk_16 *(1.0-DawnDusk_4)*
			(1.0 /(1.0+ 2.0*
				skyUV.x*skyUV.x +skyUV.y*skyUV.y
			));
	}color*=(lyt *ambience);
}