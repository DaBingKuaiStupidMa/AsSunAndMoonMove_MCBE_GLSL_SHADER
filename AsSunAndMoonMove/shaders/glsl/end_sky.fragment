// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.

precision highp float;
#include "fragmentVersionCentroid.h"
#include "uniformShaderConstants.h"
#include "util.h"

#if __VERSION__ >= 300
	#if defined(TEXEL_AA) && defined(TEXEL_AA_FEATURE)
		_centroid in highp vec2 uv;
	#else
		_centroid in vec2 uv;
	#endif
#else
	varying vec2 uv;
#endif
LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;
uniform float TOTAL_REAL_WORLD_TIME;
uniform vec4 FOG_COLOR;
uniform vec4 SUN_DIR;
varying vec3 skyXYZ;
// XZmxIs1000.0 // YmaxIs1256.0 // YminIs-744.0

bool getCld(vec2 xy, vec2 xy0){
	highp int x=int(xy.x+(xy0.x>0.0 ?0.0001 :-0.0001));
	highp int y=int(xy.y+(xy0.y>0.0 ?0.0001 :-0.0001));
//	SALL NOT CHANGE
	highp uint seed =uint(x) *0x9e3779b1u +uint(y) *0x85ebca6bu;
    seed =(seed ^(seed >>16u)) *0x85ebca6bu;
    seed =(seed ^(seed >>13u)) *0xc2b2ae35u;
    seed = seed ^(seed >>16u);
//	weather clear?
    seed =seed >>16u;
    const uint FILTER=uint(65536.0 *0.95);
    return seed >FILTER;
}

#define MAGNIF 1.1
#define MAX_STEP 2
#define MAX_HYT 0.3
//  just for compression
#define x_IfHitEndStep {\
	if(xy0.x>0.0 ?\
		(xy2.x-xy1.x) *scale >xy0.x :\
		(xy2.x-xy1.x) *scale <xy0.x\
	){\
		Alf=0.0; break;\
	}if(getCld(xy2, xy0)){\
		normal.x=1.0;\
		Alf =1.0-scale *(xy2.x-xy1.x) /xy0.x; break;\
}}
#define y_IfHitEndStep {\
	if(xy0.y>0.0 ?\
		(xy2.y-xy1.y) *scale >xy0.y :\
		(xy2.y-xy1.y) *scale <xy0.y\
	){\
		Alf=0.0; break;\
	}if(getCld(xy2, xy0)){\
		normal.z=1.0;\
		Alf =1.0-scale *(xy2.y-xy1.y) /xy0.y; break;\
}}
vec4 endCldNmlAlf(vec3 sky, float time){
    vec2 mov=vec2(0.25 *time);	vec2 xy0=sky.xz;
    vec2 xy1=xy0 -mov;          bool isCld=getCld(xy1, xy0);
	float Alf=0.0;              vec3 normal=vec3(0.0);
    float scale =sky.y *(1.0/MAX_HYT);
	if(isCld) normal.y=1.0, Alf=1.0;
	else{
        vec2 xy2=floor(xy1);        xy2 =xy2+step(vec2(0.0), xy0);
        vec2 Tstep=normalize(xy0);  Tstep=vec2(
            Tstep.x==0.0 ?2147483647.0 :1.0/Tstep.x,
            Tstep.y==0.0 ?2147483647.0 :1.0/Tstep.y
        );vec2 t=(xy2-xy1)*Tstep;
        vec2 XYstep=sign(xy0);      Tstep=abs(Tstep);
		do{ // 第一步并不是整的，而且可能立即遇到侧面
			if(t.x<t.y){
				t.x+=Tstep.x; xy2.y-=XYstep.y; x_IfHitEndStep
			}else{
				t.y+=Tstep.y; xy2.x-=XYstep.x; y_IfHitEndStep
            }
		}while(false); lowp int n=0;
        if(Alf==0.0) while(true){
            if(t.x<t.y){
				t.x+=Tstep.x; xy2.x+=XYstep.x; x_IfHitEndStep
            }else{
				t.y+=Tstep.y; xy2.y+=XYstep.y; y_IfHitEndStep
            }if(++n>MAX_STEP) break;
        }
    }return vec4(normal, max(0.0, Alf));
}
void main(){
	vec3 skydir=normalize(skyXYZ); float hyt=skydir.y;
	vec3 sunat	=vec3(SUN_DIR.x*0.8660254038, SUN_DIR.y*0.8660254038, 0.5);
	vec4 color; color.rgb=vec3(0.15,0.05,0.15);
    gl_FragColor=mix(FOG_COLOR, color, max(0.0, hyt));
	gl_FragColor.a=1.0; // skyColor

	color=mix(gl_FragColor, vec4(0.8,0.8,0.5,1.0), 0.2);
	if(skydir.y<0.15)	return;
    vec3 sky=skyXYZ;	float temp=1256.0/skyXYZ.y;
	sky.xz*=temp; 		sky.y=1256.0;
	sky*=1.0/(256.0*MAGNIF);
	vec4 v4_temp =endCldNmlAlf(sky, TOTAL_REAL_WORLD_TIME);

	float lyt=abs(dot(v4_temp.xyz, sunat));
	lyt=0.85 +0.1732 *lyt; // 0.1732是计算值
	color.rgb*=vec3(lyt);
 	color.a =v4_temp.a *clamp(4.0*(skydir.y-0.15),0.0,1.0);

	gl_FragColor=mix(gl_FragColor,color,color.a);
	gl_FragColor.a=1.0;
}