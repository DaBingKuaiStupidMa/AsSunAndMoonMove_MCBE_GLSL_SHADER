// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.

#include "fragmentVersionCentroid.h"

#if __VERSION__ >= 300
	#ifndef BYPASS_PIXEL_SHADER
		#if defined(TEXEL_AA) && defined(TEXEL_AA_FEATURE)
			_centroid in highp vec2 uv0;
			_centroid in highp vec2 uv1;
		#else
			_centroid in vec2 uv0;
			_centroid in vec2 uv1;
		#endif
	#endif
#else
	#ifndef BYPASS_PIXEL_SHADER
		varying vec2 uv0;
		varying vec2 uv1;
	#endif
#endif

varying vec4 color;
#ifdef FOG
	varying vec4 fogColor;
#else
	vec4 fogColor=vec4(0.0);
#endif

#include "uniformShaderConstants.h"
#include "util.h"

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;
LAYOUT_BINDING(1) uniform sampler2D TEXTURE_1;
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2;

//	uv1.x, block lyt.
//	uv1.y, shadowed sky lyt.
uniform vec4 SUN_DIR;
varying vec3 worldXYZ;
varying vec4 sunat;
varying float DawnDusk;

void main()
{
#ifdef BYPASS_PIXEL_SHADER
	gl_FragColor = vec4(0, 0, 0, 0);
	return;
#else 

#if USE_TEXEL_AA
	vec4 diffuse = texture2D_AA(TEXTURE_0, uv0);
#else
	vec4 diffuse = texture2D(TEXTURE_0, uv0);
#endif

#ifdef SEASONS_FAR
	diffuse.a = 1.0;
#endif

#if USE_ALPHA_TEST
	#ifdef ALPHA_TO_COVERAGE
	#define ALPHA_THRESHOLD 0.05
	#else
	#define ALPHA_THRESHOLD 0.5
	#endif
	if(diffuse.a < ALPHA_THRESHOLD)
		discard;
#endif

	vec4 inColor=color;
	vec4 myColor=color; // Have to do.
	vec3 ambience;
	float lyt, temp;

#if defined(BLEND)
	diffuse.a *= inColor.a;
#endif

	highp vec3 v_sigma=worldXYZ;
	v_sigma=cross(dFdx(v_sigma), dFdy(v_sigma));
	v_sigma=normalize(v_sigma);
	vec3 normal=v_sigma;

#if !defined(ALWAYS_LIT)

//if(gl_FragCoord.x<1280.0){

//	Get rid of default lyts: 
//	1.0 at y+, 0.8 at z, 0.6 at x, 0.5 at y-;
//	In HELL: 0.9 at y+, 0.9 at y-.
	lyt=
	abs(normal.x)>0.9 ? 5.0/3.0:(
		abs(normal.z)>0.9 ? 1.25:(
			abs(normal.y)<0.9 ? 1.0:(
				sunat.w>1.5 ? 10.0/9.0:(
					normal.y<0.0 ? 2.0 :1.0
				) // sunat.w==End1Hell2
			)
		)
	);myColor.rgb*=vec3(lyt, lyt, lyt);
//	inColor still carries biome and corner information.

//	Sunshine And Moonlight
	temp=dot(sunat.xyz, normal);
	temp=0.5 +0.5 *temp; // [-1.0, 1.0] to [0.0, 1.0]
	temp*=DawnDusk; // Lyt fades.
	lyt=((
		SUN_DIR.w>0.5 || // daytime
		sunat.w>0.5 // End1Hell2
	)?
		temp *1.2:// sunshine
		temp *0.5 // moonlyt
	);
	lyt *=sunat.w>0.5 ? 1.0 :uv1.y; // shadowed
	lyt=0.45 +0.55 *lyt; // lyten

//	Mixing block lyt and shadowed sky lyt.
	lyt=lyt +uv1.x*(1.0-lyt);

//	Darkness in corners lit up by block lyt.
	temp=max(max(myColor.r, myColor.g), myColor.b);
	if(temp!=1.0){
		temp=1.0/max(temp, 0.01); // ANTI overexposure
		myColor.rgb=mix(
			myColor.rgb,
			myColor.rgb *vec3(temp, temp, temp),
			uv1.x*uv1.x
		);
	}

//	Lyt at dawn and dusk or around a light source is WARMER,
//	while at night looks COLDER.
	ambience=vec3(1.0);
	if(SUN_DIR.w<0.5){
		ambience.rgb +=
			vec3(-0.5, -0.5, 1.5) *uv1.y*
			0.2 *lyt;
	}else if(DawnDusk<1.0 && SUN_DIR.w>0.5){
		ambience.rgb +=
			vec3(0.9, -0.1, 0.2) *uv1.y*
			0.8 *DawnDusk *(1.0-DawnDusk);
	}
	ambience.rgb=mix(
		ambience.rgb,
		vec3(1.0)+vec3(0.1, 0.05, -0.1),
		uv1.x*uv1.x
	);
	myColor.rgb=min(vec3(1.0), myColor.rgb*(ambience*lyt));

//}else diffuse *= texture2D( TEXTURE_1, uv1 ); // 方块照明、天光遮阴。

#endif

	if( // clearer water.
		myColor.a<0.9 && myColor.a>0.1
		&&(
			myColor.r!=myColor.b ||
			myColor.r!=myColor.g
		)
	)myColor.a*=0.5;

#ifndef SEASONS // ORDINARY mixing
	#if !USE_ALPHA_TEST && !defined(BLEND)
		diffuse.a =myColor.a;
	#endif
	diffuse.rgb *=myColor.rgb;
#else // Leave's color changes, forcing me to use an extra argument "myColor".
	vec2 uv =inColor.xy;
	diffuse.rgb *=mix(vec3(1.0,1.0,1.0), texture2D(TEXTURE_2, uv).rgb*2.0, inColor.b);
//if(gl_FragCoord.x<1280.0){
	temp=normal.y<-0.9 ? 2.0:(
		abs(normal.x)>0.9 ? 5.0/3.0:(
			abs(normal.z)>0.9 ? 1.25 :1.0
		)
	);inColor.a*=temp;
	diffuse.rgb*=inColor.aaa;
	diffuse.rgb*=min(vec3(1.0), ambience*lyt);
	diffuse.a 	=1.0;
/* }else{
	diffuse.rgb *= inColor.aaa;
	diffuse.a = 1.0;
} */
#endif

#ifdef FOG
	diffuse.rgb = mix(diffuse.rgb, fogColor.rgb, fogColor.a);
#endif

	gl_FragColor = diffuse;

#endif // BYPASS_PIXEL_SHADER
}