// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.

#include "fragmentVersionCentroid.h"
#include "uniformShaderConstants.h"
#include "FeatherTools.h" // extra lib
#include "util.h"

#if __VERSION__ >= 300
	#ifndef BYPASS_PIXEL_SHADER
		#if defined(TEXEL_AA) && defined(TEXEL_AA_FEATURE)
			_centroid in highp vec2 uv0;
			_centroid in highp vec2 uv1;
		#else
			_centroid in vec2 uv0;
			_centroid in vec2 uv1;
		#endif
	#endif
#else
	#ifndef BYPASS_PIXEL_SHADER
		varying vec2 uv0;
		varying vec2 uv1;
	#endif
#endif // uv1.x是方块光照，uv1.y是包含了遮阴和天气但不包括昼夜的天空光

#ifdef FOG
	varying vec4 fogColor;
#else
	vec4 fogColor=vec4(0.0);
#endif

LAYOUT_BINDING(0) uniform sampler2D TEXTURE_0;
LAYOUT_BINDING(1) uniform sampler2D TEXTURE_1;
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2;

uniform vec4 SUN_DIR;
//uniform vec2 FOG_CONTROL; // for measurement
varying vec4 color;
varying vec3 worldXYZ, sunDir, fakeSun, fakeNml, position16, v_DawnDusk;
varying float End1Hell2, dayClear;

void main(){
#ifdef BYPASS_PIXEL_SHADER
	gl_FragColor = vec4(0, 0, 0, 0);
	return;
#else // 持续到main()函数结尾

#if USE_TEXEL_AA
	vec4 txColor = texture2D_AA(TEXTURE_0, uv0);
#else
	vec4 txColor = texture2D(TEXTURE_0, uv0);
#endif

#ifdef SEASONS_FAR
	txColor.a = 1.0;
#endif

#if USE_ALPHA_TEST
	#ifdef ALPHA_TO_COVERAGE
	#define ALPHA_THRESHOLD 0.05
	#else
	#define ALPHA_THRESHOLD 0.5
	#endif
	if(txColor.a < ALPHA_THRESHOLD)
		discard;
#endif

#if defined(BLEND)
	txColor.a *=color.a;
#endif
vec4 AOBO=vec4(color.rgb, txColor.a); // ambient_occlusion & biome_color
vec3 normal, ambience, v_temp;
float temp, lyt, rgbMaxInv;

#if !defined(ALWAYS_LIT)

	highp vec3 v_sigma=worldXYZ;
	v_sigma=cross(dFdx(v_sigma), dFdy(v_sigma));
	v_sigma=normalize(v_sigma);
	normal=v_sigma;

	bool isVege =(position16.x>0.0 &&position16.y>0.0 &&position16.z>0.0);
	float removeFacing=1.0;
	if(!isVege){ // 为了竹叶的正确性，并免去非方块植被的运算。
//	剔除原版各个朝向亮度: 1.0 at y+, 0.8 at z, 0.6 at x, 0.5 at y-; 地狱: 0.9 at y+, 0.9 at y-
		float removeFacing=
		abs(normal.x)>0.9 ? 5.0/3.0:(
			abs(normal.z)>0.9 ? 1.25:(
				abs(normal.y)<0.9 ? 1.0:(
					End1Hell2>1.5 ? 10.0/9.0:(
						normal.y<0.0 ? 2.0 :1.0
		))));AOBO.rgb*=removeFacing;
//	修复向上透视树叶顶面，垂滴叶底面，水底看水面等情况的错误
		AOBO.rgb =AOBO.g>1.1 ||color.a<0.95 ?color.rgb :AOBO.rgb;
	}

//	日月光漫反射
	v_temp=vec3(0.0,1.0,0.0);
	float upDiffuse=getDiffuse( // 方块顶面的漫反射
    	sunDir, v_temp, SUN_DIR.w>0.5, End1Hell2>0.5, v_DawnDusk.x, v_DawnDusk.y, uv1.y
	);
	float diffuse;
	if( // 草丛的亮度要与它扎根的方块和谐，所以要单独计算
		abs(normal.y)<0.1 && abs(abs(normal.x)-abs(normal.z))<0.1
	)	diffuse=upDiffuse +0.05*dot(fakeSun,v_temp)*(SUN_DIR.w>0.5? v_DawnDusk.x:v_DawnDusk.y);
	else
		diffuse=getDiffuse(
			sunDir, normal, SUN_DIR.w>0.5, End1Hell2>0.5, v_DawnDusk.x, v_DawnDusk.y, uv1.y
		);
	diffuse*=useDayClear(0.2); // 引入天气

//	日月光反射（大光斑）
	float reflekt; if(End1Hell2<0.5){
		float holder=dot(normal, fakeSun);
		if(holder<0.0) reflekt=0.0; // 背光面不该有反射
		else{ // 将阳光恰好反射到摄像机所需的法向
			v_temp=fakeNml-normal; v_temp*=v_temp;
//	微表面法向要以表面整体法向为中心随机分布，在光滑的表面标准差更小
			#ifdef BLEND
				reflekt=1.0/(1.0 +16.0 *sumOfXYZ(v_temp));
			#else // 认为透明方块应当光滑，并且反光更加明亮
				reflekt=0.5/(1.0 +2.0 *sumOfXYZ(v_temp));
			#endif
//	上午的背光面可变成下午的向光面，为了避免亮度突变，必须引入边界因子
			if(abs(SUN_DIR.x)<0.99) reflekt*=min(1.0, holder*10.0);
//	为了美观，反射光不随距离衰减，但是受到昼夜、遮阴、光滑程度、天气等调控
			reflekt*=SUN_DIR.w>0.5 ?1.0 :0.5;	reflekt*=uv1.y;
			reflekt*=useDayClear(0.7);			reflekt*=v_DawnDusk.z; // 边界因子在朝暮时分并不工作
	}}else reflekt=0.0;

	float invAO=1.0; // 反暗角
	bool notGray =(abs(AOBO.r-AOBO.b) +abs(AOBO.r-AOBO.g) >0.0001);
	rgbMaxInv =maxOfRGB(AOBO);
	if(!isVege){ // 草丛没有暗角
		AOBO.rgb*=vec3(0.6+0.4*AOBO.g); // 增强暗角
		rgbMaxInv =1.0 /max(rgbMaxInv,0.01); // to avoid overexposure
		AOBO.rgb=mix(AOBO.rgb, AOBO.rgb*vec3(rgbMaxInv), uv1.x); // 方块照亮暗角
		if(!notGray) invAO=max(0.0, (AOBO.g-0.456)*(1.0/0.544));
	}
//	依次是夜间冷色氛围、晨昏粉红氛围、末地淡紫氛围、灯光橙黄氛围
	ambience=vec3(1.0);
	if(SUN_DIR.w<0.5 && End1Hell2<0.5){
		ambience +=vec3(-0.5, -0.5, 1.5) *uv1.y *0.2 *diffuse *v_DawnDusk.y;
	}else if(v_DawnDusk.x<1.0 && SUN_DIR.w>0.5){
		#ifndef BLEND // 晨昏氛围早开始，注意reflekt已含DD16，另外彩色的暗角不美观，要*invAO削弱暗角处的氛围
			ambience +=vec3(0.5, -0.4, -0.2) *uv1.y *(1.0-v_DawnDusk.x) *(0.2*v_DawnDusk.z+0.8*reflekt) *invAO;
		#else // 头vec3与不透明方块不同，是为防止冰面超红
			ambience +=vec3(0.5, -0.2, -0.2) *uv1.y *(1.0-v_DawnDusk.x) *(0.2*v_DawnDusk.z+0.8*reflekt) *invAO;
		#endif
	}
	if(End1Hell2>0.5 && End1Hell2<1.5) ambience +=vec3(0.04,-0.08,0.06); // 末地氛围
	else ambience =mix(ambience, vec3(1.0)+vec3(0.1, 0.05, -0.1), uv1.x); // 灯光氛围

//	光照汇总
	#ifdef BLEND // 认为透明方块应当光滑
		if(notGray){ // 原版水面很暗，为了凸显反射，有必要将水的颜色提亮
			AOBO.rgb=mix(AOBO.rgb, vec3(0.4,0.7,0.95), 0.5*reflekt);
			float txGray=getGray(txColor);
			txGray=max(0.0,-3.2+7.0*txGray);
			reflekt *=1.0 +4.0 *txGray; // 专供水面高光
		}
		lyt =diffuse +uv1.x*(1.0-diffuse); // 引入方块光
		lyt =lyt +0.12 *reflekt; // 混合漫反射与反射，0.12是经验值
		AOBO.a=mix(AOBO.a, 1.0, reflekt); // 提高不透明度来凸显反射与高光
	#else
		lyt =diffuse +uv1.x*(1.0-diffuse);
		lyt =lyt +reflekt *0.7;//((4.0/3.0)-lyt);
	#endif
#endif // IFNDEF ALWAYS_LIT

//	将光照应用到材质
rgbMaxInv =maxOfRGB(txColor);
rgbMaxInv =1.0 /max(rgbMaxInv,0.01); // to avoid overexposure
vec3 txOverLyt =txColor.rgb *rgbMaxInv;

#ifndef SEASONS // 覆雪树叶以外的混合
	#if !USE_ALPHA_TEST && !defined(BLEND)
		txColor.a =AOBO.a;
	#endif
	txColor.rgb *=AOBO.rgb *lyt *ambience;
	txColor.rgb =min(txColor.rgb, txOverLyt);
#else // 覆雪树叶的渲染中，MOJANG用color.a来承载AO与各个朝向亮度，color.rgb则控制雪天的白化
	vec2 uv =color.xy;
	txColor.rgb *=mix(
		vec3(1.0,1.0,1.0), texture2D(TEXTURE_2, uv).rgb*2.0, color.b
	);temp=color.a;
	#if !defined(ALWAYS_LIT)
		temp*=removeFacing;
		if(temp>1.1) temp=color.a; // 修复向上透视树叶顶面的错误
	#endif
	txColor.rgb *=temp *lyt *ambience;
	txColor.rgb =min(txColor.rgb, txOverLyt);
	txColor.a=1.0;
#endif

#ifdef FOG
	txColor.rgb = mix(txColor.rgb, fogColor.rgb, fogColor.a);
#endif
	gl_FragColor = txColor;
//	for measurement
//	if(gl_FragCoord.x>1280.0) {gl_FragColor=vec4(position1, 1.0);/* gl_FragColor.a=1.0; */return;}
#endif // BYPASS_PIXEL_SHADER
}