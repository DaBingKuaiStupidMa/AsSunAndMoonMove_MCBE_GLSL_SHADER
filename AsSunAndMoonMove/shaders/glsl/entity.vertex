// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.

#include "entityVertexUtil.h"
#include "FeatherTools.h" // extra lib

varying vec4 light; // 光照值 vec4(r, g, b, a)
varying vec4 fogColor; // 雾色与雾强度 vec4(r, g, b, 雾强度)
varying vec2 uv1;
varying float DawnDusk_4, DawnDusk_8, DawnDusk_16, End1Hell2;

#ifdef RNGL_LOCAL_LIGHT
varying vec4 worldSpacePos;
varying vec4 worldSpaceNormal;
#endif 

vec4 getFog_DABINGKUAI(float dotZ){
	vec2 fog_control;
	fog_control.x=FOG_CONTROL.x;
	fog_control.y=mix(FOG_CONTROL.y,1.0,0.5);
	if(End1Hell2>1.5){ // visibility in hell enhanced
		fog_control.x=mix(fog_control.x, 1.0, 0.4);
	}
	float fogControl =((dotZ /RENDER_DISTANCE) -fog_control.x) /(fog_control.y -fog_control.x);
	return vec4(FOG_COLOR.rgb, clamp(fogControl, 0.0, 1.0));
}

vec4 getLyt_DABINGKUAI(vec4 position, vec4 normal, float dayClear){
	float lyt;
#if defined(RNGL_UNLIT) || !defined(FANCY)
	lyt =1.0;
#else
	vec3 N =normalize((WORLD *normal).xyz);

	//take care of double sided polygons on materials without culling
	#ifdef FLIP_BACKFACES
		vec3 viewDir =normalize((WORLD *position).xyz);
		if(dot(N, viewDir) >0.0) N *=-1.0;
	#endif

	#ifdef RNGL_LIGHT
		vec3 lightDir =normalize(HIDE_COLOR.xyz);  // light dir uses world coords
		float dLight =max(0.0, dot(N, lightDir));  // diffuse in directional light
		lyt =dLight *(1.0 -AMBIENT -0.2) +AMBIENT+0.2;  // origin range [0.65, 1.0]
	#else
		vec3 sunDir=vec3(SUN_DIR.x*0.8660254038, SUN_DIR.y*0.8660254038, 0.5);
		lyt=getDiffuse(
			sunDir, N, DawnDusk_8, uv1.y, SUN_DIR.w>0.5, End1Hell2>0.5, dayClear
		);
	#endif // RNGL_LIGHT
#endif
#ifdef USE_OVERLAY
	lyt +=OVERLAY_COLOR.a *0.35;
#endif
	return vec4(lyt, lyt, lyt, 1.0);
}

void main() {
	POS4 entitySpacePosition, entitySpaceNormal;
	// 计算顶点动画 得到模型空间位置与法线
	getEntitySpacePositionAndNormal(entitySpacePosition, entitySpaceNormal);
	calculateOverlayColor(); // 受伤变红等效果
	calculateGlint(); // 计算附魔效果相关变量
	// 包含其他内置宏相关的varying计算
	entityCommonVert();
	// 变量uv已经在头文件中预先声明 这里使用TEXCOORD_0作为uv值
	uv =TEXCOORD_0;
	// 计算顶点uv 包括MC支持的UV序列帧效果
	applyUVAnim(uv);
	calculateSpecificProcess(entitySpacePosition, entitySpaceNormal);
	// 变换到投影空间
	POS4 projSpacePos =WORLDVIEWPROJ *entitySpacePosition;
	gl_Position =projSpacePos;

#ifdef RNGL_LOCAL_LIGHT
	worldSpacePos =WORLD *entitySpacePosition;
	worldSpaceNormal =WORLD *entitySpaceNormal;
	worldSpaceNormal.xyz =normalize(worldSpaceNormal.xyz);
#endif
	// 根据投影位置 计算雾的效果
	fogColor =getFog_DABINGKUAI(projSpacePos.z);

	End1Hell2 =getEnd1Hell2(fogColor, FOG_CONTROL.x);
	calcDawnDusk4_8_16
	bool gamePauseModel=
	(fogColor.r==1.0 && fogColor.g==1.0 &&
	fogColor.b==1.0 && FOG_CONTROL.x==0.0);

	uv1.y=max(TILE_LIGHT_INTENSITY.y, TILE_LIGHT_COLOR.g); // for left top model
	// 计算CUSTOM的MC顶点光照
	float dayClear=1.0;
	if(gamePauseModel){
		uv1.x=0.0;
	}else{
		uv1.x=TILE_LIGHT_INTENSITY.x; // fc.x>0.01 abuvWater
		if(End1Hell2<0.5 && FOG_CONTROL.x>0.01) dayClear=getDayClear(FOG_CONTROL.y);
	}light=getLyt_DABINGKUAI(entitySpacePosition, entitySpaceNormal, dayClear);
}